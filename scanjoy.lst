     6                          ;
     7                          ; avoid joystick / keyboard conflicts by detecting the conflicts and dealing with them
     8                          ; masks joystick out of keyboard reads, and masks keyboard out of joystick reads
     9                          
    10                          scan=$cb     ; last keyboard scan 0..64, 64=none
    11                          shflag=$28d  ; shift(1)/commodore(2)/control(4) flags
    12                          CIAPRA=$dc00 ; CIA#1 Data Port Register A
    13                          CIAPRB=$dc01 ; CIA#1 Data Port Register B
    14                          kbdmatrix=$eb81
    15                          CHROUT=$ffd2 ; KERNAL character out
    16                          joy1 = $fd
    17                          joy2 = $fe
    18                          oldirq = $ea31
    19                          oldkeylog = $eb48
    20                          irqvector = $314
    21                          keylogvector = $28f
    22                          
    23                          *=$c000
    24  c000 4c06c0                 jmp init
    25  c003 4c24c0                 jmp doscan
    26                          
    27                          init:
    28  c006 a944                   lda #<title
    29  c008 a2c1                   ldx #>title
    30  c00a 20bac0                 jsr strout
    31  c00d 78                     sei
    32  c00e a9cb                   lda #<newirq
    33  c010 a2c0                   ldx #>newirq
    34  c012 8d1403                 sta irqvector
    35  c015 8e1503                 stx irqvector+1
    36  c018 a91b                   lda #<newkeylog
    37  c01a a2c1                   ldx #>newkeylog
    38  c01c 8d8f02                 sta keylogvector
    39  c01f 8e9002                 stx keylogvector+1
    40  c022 58                     cli
    41  c023 60                     rts
    42                          
    43                          doscan:
    44  c024 08                     php
    45  c025 78                     sei
    46  c026 a940                   lda #64
    47  c028 85cb                   sta scan
    48  c02a a900                   lda #0
    49  c02c 8d8d02                 sta shflag
    50  c02f 8d00dc                 sta CIAPRA
    51  c032 ad01dc             -   lda CIAPRB
    52  c035 cd01dc                 cmp CIAPRB
    53  c038 d0f8                   bne -
    54  c03a c9ff                   cmp #$ff
    55  c03c f073                   beq exitscan
    56  c03e a000                   ldy #0
    57  c040 a2fe                   ldx #$fe
    58                          scancol:
    59  c042 a9ff                   lda #$ff
    60  c044 8d00dc                 sta CIAPRA
    61  c047 ad01dc             -   lda CIAPRB
    62  c04a cd01dc                 cmp CIAPRB
    63  c04d d0f8                   bne -
    64  c04f 49ff                   eor #$ff
    65  c051 85fd                   sta joy1
    66  c053 8e00dc                 stx CIAPRA
    67  c056 ad01dc             -   lda CIAPRB
    68  c059 cd01dc                 cmp CIAPRB
    69  c05c d0f8                   bne -
    70  c05e 05fd                   ora joy1
    71  c060 c9ff                   cmp #$ff
    72  c062 f03f                   beq notrow
    73  c064 48                     pha
    74  c065 a9ff                   lda #$ff
    75  c067 8d00dc                 sta CIAPRA
    76  c06a ad01dc             -   lda CIAPRB
    77  c06d cd01dc                 cmp CIAPRB
    78  c070 d0f8                   bne -
    79  c072 49ff                   eor #$ff
    80  c074 c5fd                   cmp joy1
    81  c076 f004                   beq +
    82  c078 68                     pla
    83  c079 4c42c0                 jmp scancol
    84  c07c 68                 +   pla
    85                          nextcol:
    86  c07d 4a                     lsr
    87  c07e 48                     pha
    88  c07f b015                   bcs +
    89  c081 c03f                   cpy #$3f
    90  c083 f00f                   beq notshift
    91  c085 b981eb                 lda kbdmatrix,y
    92  c088 c905                   cmp #5
    93  c08a b008                   bcs notshift
    94  c08c 0d8d02                 ora shflag
    95  c08f 8d8d02                 sta shflag
    96  c092 d002                   bne +
    97                          notshift:
    98  c094 84cb                   sty scan
    99  c096 c8                 +   iny
   100  c097 98                     tya
   101  c098 2907                   and #7
   102  c09a 18                     clc
   103  c09b d001                   bne +
   104  c09d 38                     sec
   105  c09e 68                 +   pla
   106  c09f b007                   bcs +
   107  c0a1 90da                   bcc nextcol
   108                          notrow:
   109  c0a3 98                     tya
   110  c0a4 18                     clc
   111  c0a5 6908                   adc #8
   112  c0a7 a8                     tay
   113  c0a8 8a                 +   txa
   114  c0a9 38                     sec
   115  c0aa 2a                     rol
   116  c0ab aa                     tax
   117  c0ac b094                   bcs scancol
   118  c0ae 2021c1                 jsr checkjoy1fire2
   119                          exitscan:
   120  c0b1 a5cb                   lda scan
   121  c0b3 ae8d02                 ldx shflag
   122  c0b6 a000                   ldy #0
   123  c0b8 28                     plp
   124  c0b9 60                     rts
   125                          
   126                          strout:
   127  c0ba 85fb                   sta $fb
   128  c0bc 86fc                   stx $fc
   129  c0be a000                   ldy #0
   130  c0c0 b1fb               -   lda ($fb),y
   131  c0c2 f006                   beq +
   132  c0c4 20d2ff                 jsr CHROUT
   133  c0c7 c8                     iny
   134  c0c8 d0f6                   bne -
   135  c0ca 60                 +   rts
   136                          
   137                          newirq:
   138                          ; read joystick 1
   139  c0cb a9ff                   lda #$ff
   140  c0cd 8d00dc                 sta CIAPRA
   141  c0d0 ad01dc             -   lda CIAPRB
   142  c0d3 cd01dc                 cmp CIAPRB
   143  c0d6 d0f8                   bne -
   144  c0d8 49ff                   eor #$ff
   145  c0da 291f                   and #$1f
   146  c0dc 85fd                   sta joy1
   147  c0de 2021c1                 jsr checkjoy1fire2
   148                          
   149                          ; read joystick 2
   150  c0e1 a9ff                   lda #$ff
   151  c0e3 8d02dc                 sta $dc02
   152  c0e6 a9ff                   lda #$ff
   153  c0e8 8d00dc                 sta $dc00
   154  c0eb ad00dc             -   lda CIAPRA
   155  c0ee cd00dc                 cmp CIAPRA
   156  c0f1 d0f8                   bne -
   157  c0f3 49ff                   eor #$ff
   158  c0f5 291f                   and #$1f
   159  c0f7 85fe                   sta joy2
   160  c0f9 a9bf                   lda #$ff-$40
   161  c0fb 8d00dc                 sta $dc00
   162  c0fe 203cc1                 jsr delay512instructions
   163  c101 ad19d4             -   lda $d419
   164  c104 cd19d4                 cmp $d419
   165  c107 d0f8                   bne -
   166  c109 c900                   cmp #0
   167  c10b d006                   bne +
   168  c10d a5fe                   lda joy2
   169  c10f 0920                   ora #$20
   170  c111 85fe                   sta joy2
   171                          
   172  c113 a97f               +   lda #$7f
   173  c115 8d00dc                 sta CIAPRA
   174  c118 4c31ea                 jmp oldirq
   175                          
   176                          newkeylog:
   177  c11b 2024c0                 jsr doscan
   178  c11e 4c48eb                 jmp oldkeylog
   179                          
   180                          checkjoy1fire2:
   181  c121 a97f                   lda #$ff-$80
   182  c123 8d00dc                 sta CIAPRA
   183  c126 203cc1                 jsr delay512instructions
   184  c129 ad19d4             -   lda $d419
   185  c12c cd19d4                 cmp $d419
   186  c12f d0f8                   bne -
   187  c131 c900                   cmp #0
   188  c133 d006                   bne +
   189  c135 a5fd                   lda joy1
   190  c137 0920                   ora #$20
   191  c139 85fd                   sta joy1
   192  c13b 60                 +   rts
   193                          
   194                          ; 6 + 2 + 99 * (2+3) - 1 + 2 + 2 + 6 = 8 + 495 + 9 = 512
   195                          delay512instructions: ; JSR = 6 cycles
   196  c13c a263                   ldx #99 ; 2 cycles
   197  c13e ca                 -   dex ; 2 cycles
   198  c13f d0fd                   bne - ; 3 cycles branch -or- 2 cycles w/o -or- 4 across page
   199  c141 18                     clc ; 2 cycles
   200  c142 18                     clc ; 2 cycles
   201  c143 60                     rts ; 6 cycles
   202                          
   203                          title: 
   204  c144 93                     !byte 147
