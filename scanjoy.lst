   207  c182 1242592044415649...    !text 18,"BY DAVID R. VAN WAGNER       DAVEVW.COM"
   208  c1aa 9d9d9d9d9d9d9d9d...    !text 157,157,157,157,157,157,157,157,157,157,148,32,13
